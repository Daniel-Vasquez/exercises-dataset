# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - API REST DE EJERCICIOS FÍSICOS
# ==============================================================================
# Copia este archivo como '.env' y completa los valores correspondientes.
# NUNCA subas el archivo '.env' con credenciales reales a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR Y ENTORNO
# ------------------------------------------------------------------------------
# Entorno de ejecución ('development' | 'production' | 'test')
NODE_ENV=development

# Puerto local para desarrollo
PORT=3000

# Prefijo global para las rutas de la API
API_PREFIX=/api/v1

# Orígenes permitidos para CORS (separados por comas en caso de múltiples)
# En desarrollo puedes usar '*' o 'http://localhost:5173', en producción la URL de tu frontend.
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# URI completa de conexión a MongoDB Atlas (Tier M0 Free).
# Ejemplo: mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/exercises_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>.mongodb.net/<database_name>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. ALMACENAMIENTO MULTIMEDIA (CLOUDINARY)
# ------------------------------------------------------------------------------
# Credenciales obtenidas en el Dashboard de Cloudinary (https://console.cloudinary.com/)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# URL completa opcional (algunos SDKs permiten usar esta variable directa)
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_cloud_name

# Carpeta raíz dentro de Cloudinary donde se almacenarán los recursos
CLOUDINARY_FOLDER=exercises

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE CACHÉ Y RENDIMIENTO
# ------------------------------------------------------------------------------
# Tiempo en segundos para caché pública en Edge CDN de Vercel (s-maxage: 86400 = 24 horas)
CDN_CACHE_TTL_SECONDS=86400

# Tiempo en segundos para servir contenido obsoleto mientras se revalida en segundo plano
CDN_SWR_TTL_SECONDS=43200

# Límite máximo de elementos por página permitidos en consultas paginadas
PAGINATION_MAX_LIMIT=100

# Límite por defecto de elementos por página si no se especifica
PAGINATION_DEFAULT_LIMIT=20
